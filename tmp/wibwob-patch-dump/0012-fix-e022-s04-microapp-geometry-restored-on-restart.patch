From 2cd1ad3198d97dc085cac2d629990de8c4d92b4b Mon Sep 17 00:00:00 2001
From: James Greig <3stripe@gmail.com>
Date: Sat, 7 Mar 2026 12:20:40 +0000
Subject: [PATCH 12/32] fix(e022-s04): microapp geometry restored on restart
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add 'microapp' cases to workspace-snapshots.ts serialize/restore switches.

Serialize: registrySerialize(window) delegates to the dynamic handler registered
via host.registerSnapshot — captures seed, renderMode, etc. into payload.

Restore: actions.restoreMicroapp(snapshot) dispatches to registryRestore which
calls the module's restore handler (opens window via host.runCommand). The window
is then picked up by getLastWindow() and geometry is applied.

WorkspaceRestoreActions gains restoreMicroapp(snapshot) → bool. AppController
implements it via registryRestore with a stub actions cast (dynamic handlers
use host.runCommand internally, never touch _actions).
---
 src/core/app-controller.ts      | 8 ++++++++
 src/core/workspace-snapshots.ts | 8 ++++++++
 2 files changed, 16 insertions(+)

diff --git a/src/core/app-controller.ts b/src/core/app-controller.ts
index 60e4d97..4753c80 100644
--- a/src/core/app-controller.ts
+++ b/src/core/app-controller.ts
@@ -12,6 +12,8 @@ import { MenuOverlayManager } from "./menu-overlay-manager.js";
 import { OverlayManager } from "./overlay-manager.js";
 import { theme, toggleTheme as toggleThemeVariant } from "./theme/resolver.js";
 import { isRightClick } from "./ui-primitives.js";
+import { registryRestore } from "./snapshot-registry.js";
+import type { SnapshotRestoreActions } from "./snapshot-registry.js";
 import { restoreWindowSnapshot, serializeWindowSnapshot, type WorkspaceRestoreActions } from "./workspace-snapshots.js";
 import type {
   BackroomsChannel,
@@ -887,6 +889,12 @@ export class TsTuiMvpApp {
       openCompanionWindow: (restore) => this.openCompanionWindow(restore),
       openArtWindow: () => this.openArtWindow(),
       openStateInspectorWindow: () => this.openStateInspectorWindow(),
+      restoreMicroapp: (snapshot) => {
+        // Microapp restore handlers call host.runCommand() internally — _actions is unused.
+        // Empty stub cast is safe: no dynamic handler reads _actions.
+        const result = registryRestore(snapshot, {} as unknown as SnapshotRestoreActions);
+        return result !== undefined;
+      },
       windows: this.windowManager
     };
   }
diff --git a/src/core/workspace-snapshots.ts b/src/core/workspace-snapshots.ts
index 4635184..75965ce 100644
--- a/src/core/workspace-snapshots.ts
+++ b/src/core/workspace-snapshots.ts
@@ -1,6 +1,7 @@
 import fs from "node:fs";
 
 import { getDefaultFigletFont } from "../services/figlet-service.js";
+import { registrySerialize } from "./snapshot-registry.js";
 import type { WindowFacade } from "./window-facade.js";
 import type { BackroomsChannel, WindowRecord, WindowSnapshot } from "./types.js";
 
@@ -82,6 +83,8 @@ export function buildWindowSnapshotPayload(window: WindowRecord): Record<string,
         tick: typeof details?.tick === "number" ? details.tick : 0
       };
     }
+    case "microapp":
+      return registrySerialize(window) ?? undefined;
     default:
       return undefined;
   }
@@ -100,6 +103,8 @@ export interface WorkspaceRestoreActions {
   openCompanionWindow: (restore?: { tick?: number }) => void;
   openArtWindow: () => void;
   openStateInspectorWindow: () => void;
+  /** Restore a dynamic microapp window from its snapshot. Returns true if a handler was found. */
+  restoreMicroapp: (snapshot: WindowSnapshot) => boolean;
   windows: WindowFacade;
 }
 
@@ -181,6 +186,9 @@ export function restoreWindowSnapshot(snapshot: WindowSnapshot, actions: Workspa
     case "inspector":
       actions.openStateInspectorWindow();
       break;
+    case "microapp":
+      actions.restoreMicroapp(snapshot);
+      break;
     default:
       break;
   }
