+
+## 8. Common Patterns and Code Examples
+
+### Opening a new window via command registry
+
+```typescript
+// In a window factory or service, dispatch a command:
+registry.run("plasma.open", { mood: "void" });
+registry.run("theme.set", { name: "wibwob-dark-pastel" });
+registry.run("window.toggle_maximize", { windowId: 4 });
+
+// Via HTTP from shell:
+curl -s -X POST http://127.0.0.1:8099/commands/run \
+  -H 'Content-Type: application/json' \
+  -d '{"id":"primer.open","args":{"filePath":"/abs/path.txt","w":72,"h":22}}'
+```
+
+### Adding a new window type (skeleton)
+
+```typescript
+// src/windows/my-thing-window.ts
+import blessed from "blessed";
+import { theme } from "../core/theme/resolver.js";
+import type { WindowManager } from "../core/window-manager.js";
+
+export function openMyThingWindow(deps: { screen: ...; windowManager: WindowManager }): void {
+  const { screen, windowManager } = deps;
+  const frame = windowManager.createFrame("My Thing", "my-thing");  // kind must be in WindowKind
+
+  const body = blessed.box({ parent: frame.body, top: 0, left: 0, right: 0, bottom: 1,
+    style: theme().body, tags: true });
+  const statusBar = blessed.box({ parent: frame.body, bottom: 0, left: 0, right: 0, height: 1,
+    style: theme().header, content: " q=close" });
+
+  frame.describeState = () => ({     // REQUIRED
+    appType: "my-thing",
+    summary: "My Thing window"
+  });
+
+  frame.cleanup = () => { /* stop timers, destroy resources */ };
+
+  frame.onRestyle = () => {
+    body.style = theme().body;
+    statusBar.style = theme().header;
+  };
+
+  body.key(["q", "escape"], () => windowManager.closeWindow(frame.id));
+  frame.focus = () => { windowManager.focusWindow(frame); body.focus(); };
+
+  windowManager.registerWindow(frame);
+  frame.focus();
+}
+```
+
+Then in `command-catalog.ts`:
+```typescript
+{ id: "my-thing.open", label: "My Thing", group: "open",
+  actionKey: "openMyThing",
+  menuPlacements: [{ category: "applications", order: 200 }],
+  api: true, agent: true }
+```
+
+And in `AppMenuActions`:
+```typescript
+openMyThing: () => void;
+```
+
+And in `app-controller.ts:getAppMenuActions()`:
+```typescript
+openMyThing: () => this.openMyThingWindow(),
+```
+
+And in `src/core/types.ts`, extend `WindowKind`:
+```typescript
+| "my-thing"
+```
+
+### Writing a microapp module
+
+```typescript
+// microapps/my-module/index.ts
+export default function setup(host: MicroappHost) {
+  host.registerCommand({
+    id: "open",            // local ID — becomes "microapp.my-module.open" globally
+    label: "Open My Module",
+    action: (args) => openMyWindow(host, args),
+    menu: [{ category: "applications", order: 200, label: "My Module" }],
+    palette: { order: 200 },
+  });
+
+  host.registerSnapshot({
+    serialize: (window) => {
+      const state = window.describeState?.() ?? {};
+      if (state.appType !== "my-module") return undefined;
+      return { param: state.param };        // serialize PARAMS not paths
+    },
+    restore: (_snapshot, payload) => {
+      host.runCommand("open", { param: payload.param });
+    },
+  });
+}
+```
+
+```json
+// microapps/my-module/microapp.json
+{
+  "name": "wibwob.my-module",
+  "type": "microapp",
+  "microapp": { "id": "my-module", "title": "My Module" }
+}
+```
+
+### Content measurement
+
+```typescript
+import { measureContent } from "../services/content-measurement.js";
+import { contentToWindowSize } from "../core/window-chrome.js";
+
+const m = measureContent(filePath, "primer");
+const { w, h } = contentToWindowSize(m);   // includes chrome offsets
+```
+
+Do not compute `m.columnWidth + 4` yourself. `contentToWindowSize` owns
+chrome math.
+
+### Workspace restore — graceful degradation
+
+```typescript
+restore: (_snapshot, payload) => {
+  const { seed, terrainIdx, seaLevel, levels } = payload;
+  if (seed !== undefined) {
+    host.runCommand("open", { seed, terrainIdx, seaLevel, levels });
+  } else {
+    host.runCommand("open");   // legacy payload — open with defaults
+  }
+}
+```
+
+### Theme token usage in blessed widgets
+
+```typescript
+import { theme } from "../core/theme/resolver.js";
+import { safeSetStyle } from "../core/ui-primitives.js";
+
+// On create:
+const box = blessed.box({ style: theme().body });
+const list = blessed.list({ style: theme().body });
+
+// On restyle (called by windowManager.restyleAll()):
+frame.onRestyle = () => {
+  safeSetStyle(box, theme().body);   // use safeSetStyle for lists/widgets with sub-styles
+  safeSetStyle(list, theme().selected);
+};
+```
+
