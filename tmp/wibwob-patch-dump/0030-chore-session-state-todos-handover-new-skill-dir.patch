+# /// script
+# requires-python = ">=3.10"
+# dependencies = ["claude-agent-sdk"]
+# ///
+"""
+Step 2: Classify candidate pairs using parallel Haiku subagent calls.
+
+Uses Claude Agent SDK's query() function — shares Claude Code's auth,
+no API key needed. Sends each candidate pair to Haiku for real LLM judgment
+on sentiment, taste signal, and creative domain.
+
+Runs N concurrent queries for speed.
+"""
+import asyncio
+import json
+import os
+import sys
+import argparse
+from pathlib import Path
+
+# Must unset before importing SDK so nested claude processes work
+os.environ.pop("CLAUDECODE", None)
+
+from claude_agent_sdk import query, ClaudeAgentOptions, ResultMessage
+
+
+CLASSIFY_PROMPT = """\
+You are classifying a human's reaction to creative output from an AI agent.
+
+AGENT OUTPUT (what was made):
+{assistant_text}
+
+HUMAN REACTION (what they said next):
+{user_text}
+
+Classify this interaction. Respond with ONLY a JSON object, no markdown fences, no explanation:
+
+{{"is_creative_reaction": true/false, "sentiment": "positive"|"negative"|"redirect"|"neutral"|"not_a_reaction", "taste_signal": "one sentence summarizing what the human liked/disliked/wanted changed, or null if not a creative reaction", "creative_domain": "art"|"music"|"layout"|"typography"|"mixed"|"none", "confidence": 0.0-1.0}}
+
+Rules:
+- "not_a_reaction" = the human message is about something else entirely (engineering, debugging, next task, system hook)
+- "neutral" = acknowledging but no taste signal ("ok", "cool", "next")
+- "redirect" = partially positive but wants changes ("love it but make X more Y")
+- Only is_creative_reaction=true if the agent message was genuinely showing creative work AND the human is reacting to that creative work
+- taste_signal should capture the WHY not just positive/negative. e.g. "prefers asymmetric layouts over grids" not just "liked it"\
+"""
+
+
+async def classify_one(
+    pair: dict,
+    semaphore: asyncio.Semaphore,
+    model: str,
+    idx: int,
+    total: int,
+) -> dict | None:
+    """Classify a single pair via Agent SDK query()."""
+    prompt = CLASSIFY_PROMPT.format(
+        assistant_text=pair["assistant_text"][:600],
+        user_text=pair["user_text"][:300],
+    )
+
+    async with semaphore:
+        try:
+            opts = ClaudeAgentOptions(
+                model=model,
+                max_turns=1,
+                permission_mode="bypassPermissions",
+            )
+
+            text = ""
+            async for msg in query(prompt=prompt, options=opts):
+                if isinstance(msg, ResultMessage):
+                    # ResultMessage.result is the final text (string)
+                    if hasattr(msg, "result") and msg.result:
+                        text = msg.result
+
+            text = text.strip()
+
+            # Strip markdown fences if present
+            if text.startswith("```"):
+                lines = text.split("\n")
+                text = "\n".join(lines[1:])
+            if text.endswith("```"):
+                text = text[: text.rfind("```")]
+            text = text.strip()
+
+            result = json.loads(text)
+
+            if not result.get("is_creative_reaction"):
+                return None
+            if result.get("sentiment") in ("not_a_reaction", "neutral"):
+                return None
+
+            if (idx + 1) % 25 == 0:
+                print(f"  [{idx+1}/{total}] classified...", file=sys.stderr)
+
+            return {
+                "output_summary": pair["assistant_text"][:500],
+                "reaction_text": pair["user_text"][:300],
+                "sentiment": result["sentiment"],
+                "taste_signal": result.get("taste_signal"),
+                "creative_domain": result.get("creative_domain", "mixed"),
+                "confidence": result.get("confidence", 0.5),
+                "session_id": pair["session_id"],
+                "date": pair["date"],
+                "source": pair["source"],
+                "project": pair["project"],
+            }
+        except (json.JSONDecodeError, KeyError, IndexError) as e:
+            print(f"  [{idx+1}] parse error: {e}", file=sys.stderr)
+            return None
+        except Exception as e:
+            print(f"  [{idx+1}] error: {type(e).__name__}: {e}", file=sys.stderr)
+            return None
+
+
+async def classify_all(
+    pairs: list[dict],
+    concurrency: int,
+    model: str,
+) -> list[dict]:
+    """Classify all pairs with bounded concurrency."""
+    semaphore = asyncio.Semaphore(concurrency)
+    total = len(pairs)
+
+    tasks = [
+        classify_one(p, semaphore, model, i, total)
+        for i, p in enumerate(pairs)
+    ]
+    results = await asyncio.gather(*tasks)
+    return [r for r in results if r is not None]
+
+
+def print_summary(reactions: list[dict]):
+    pos = [r for r in reactions if r["sentiment"] == "positive"]
+    neg = [r for r in reactions if r["sentiment"] == "negative"]
+    red = [r for r in reactions if r["sentiment"] == "redirect"]
+
+    print("Creative Feedback Index (Haiku-classified)")
+    print("=" * 60)
+    print(f"Total: {len(reactions)} ({len(pos)} positive, {len(neg)} negative, {len(red)} redirect)")
+    print()
+
+    for label, icon, group in [
+        ("LIKED", "+", pos),
+        ("DISLIKED", "-", neg),
+        ("REDIRECTED", "~", red),
+    ]:
+        if not group:
+            continue
+        print(f"{label} ({len(group)}):")
+        for r in group[:20]:
+            taste = r.get("taste_signal", "")
+            domain = r.get("creative_domain", "?")
+            if taste:
+                print(f"  [{icon}] [{r['date']}] [{r['source']}] [{domain}] {taste}")
+            else:
+                react_short = r["reaction_text"][:70].replace("\n", " ")
+                print(f"  [{icon}] [{r['date']}] [{r['source']}] [{domain}] \"{react_short}\"")
+        print()
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Classify creative pairs via Haiku subagents")
+    parser.add_argument("input", nargs="?", default="-", help="JSON from extract_pairs.py (default: stdin)")
+    parser.add_argument("--output", "-o", default=None, help="Output JSON file")
+    parser.add_argument("--summary", action="store_true", help="Print human-readable summary")
+    parser.add_argument("--concurrency", "-c", type=int, default=10, help="Max parallel queries (default: 10)")
+    parser.add_argument("--model", default="claude-haiku-4-5-20251001", help="Model for classification")
+    parser.add_argument("--min-confidence", type=float, default=0.4, help="Min confidence threshold")
+    parser.add_argument("--limit", type=int, default=0, help="Max pairs to classify (0=all)")
+    args = parser.parse_args()
+
+    # Read input
+    if args.input == "-":
+        pairs = json.load(sys.stdin)
+    else:
+        pairs = json.loads(Path(args.input).read_text())
+
+    if args.limit > 0:
+        pairs = pairs[:args.limit]
+
+    print(
+        f"Classifying {len(pairs)} pairs via Agent SDK query()"
+        f" model={args.model} concurrency={args.concurrency}...",
+        file=sys.stderr,
+    )
+
+    reactions = asyncio.run(classify_all(pairs, args.concurrency, args.model))
+    reactions = [r for r in reactions if r["confidence"] >= args.min_confidence]
+    reactions.sort(key=lambda r: (r["date"], r["confidence"]), reverse=True)
+
+    print(f"Found {len(reactions)} creative reactions", file=sys.stderr)
+
+    if args.summary:
+        print_summary(reactions)
+
+    if args.output:
+        Path(args.output).write_text(json.dumps(reactions, indent=2, ensure_ascii=False))
+        print(f"Wrote {len(reactions)} reactions -> {args.output}", file=sys.stderr)
+    elif not args.summary:
+        print(json.dumps(reactions, indent=2, ensure_ascii=False))
+
+
+if __name__ == "__main__":
+    main()
