+#!/usr/bin/env python3
+"""
+Step 1: Extract ALL assistant->user message pairs from CC + Pi session logs.
+
+No filtering, no heuristics, no word lists. Extracts every adjacent
+assistant→user pair and lets classify_pairs.py (Haiku subagents) decide
+which ones are creative reactions.
+
+Only filters out: system/hook messages, very short replies, empty messages.
+
+Output: JSON array of {assistant_text, user_text, session_id, date, source, project}
+"""
+import json
+import os
+import sys
+import argparse
+from pathlib import Path
+from datetime import datetime
+
+
+def extract_text(content) -> str:
+    if isinstance(content, str):
+        return content.strip()
+    if isinstance(content, list):
+        parts = []
+        for c in content:
+            if isinstance(c, dict) and c.get("type") == "text":
+                parts.append(c.get("text", ""))
+        return "\n".join(parts).strip()
+    return ""
+
+
+def scan_session(path: Path, source: str, project: str) -> list[dict]:
+    """Extract assistant->user pairs from one JSONL session file."""
+    messages = []
+    with open(path) as f:
+        for line in f:
+            try:
+                obj = json.loads(line)
+            except (json.JSONDecodeError, UnicodeDecodeError):
+                continue
+
+            if source == "cc":
+                obj_type = obj.get("type", "")
+                if obj_type in ("user", "assistant"):
+                    msg = obj.get("message", {})
+                    text = extract_text(msg.get("content", ""))
+                    if text and not text.startswith("<"):
+                        messages.append((obj_type, text))
+            elif source == "pi":
+                if obj.get("type") == "message":
+                    msg = obj.get("message", {})
+                    role = msg.get("role", "")
+                    text = extract_text(msg.get("content", ""))
+                    if text and role in ("user", "assistant") and not text.startswith("<"):
+                        messages.append((role, text))
+
+    pairs = []
+    session_id = path.stem
+    dt = datetime.fromtimestamp(os.path.getmtime(path)).strftime("%Y-%m-%d")
+
+    for i in range(len(messages) - 1):
+        role_a, text_a = messages[i]
+        role_b, text_b = messages[i + 1]
+
+        if role_a != "assistant" or role_b != "user":
+            continue
+
+        # Skip very short user replies (single word acks)
+        if len(text_b.strip()) < 8:
+            continue
+
+        # Skip automated hook/system messages
+        stripped = text_b.strip()
+        if stripped.startswith("Stop hook") or stripped.startswith("[Request"):
+            continue
+
+        pairs.append({
+            "assistant_text": text_a[:800],
+            "user_text": text_b[:400],
+            "session_id": session_id,
+            "date": dt,
+            "source": source,
+            "project": project,
+        })
+
+    return pairs
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        description="Extract all assistant->user pairs from session logs"
+    )
+    parser.add_argument("--cc-dir", default=str(Path.home() / ".claude/projects"))
+    parser.add_argument("--pi-dir", default=str(Path.home() / ".pi/agent/sessions"))
+    parser.add_argument("--project", "-p", default=None, help="Filter to project slug (substring)")
+    parser.add_argument("--recent", type=int, default=0, help="Only last N days")
+    parser.add_argument("--output", "-o", default=None, help="Output JSON file (default: stdout)")
+    args = parser.parse_args()
+
+    import time
+    cutoff = time.time() - (args.recent * 86400) if args.recent > 0 else 0
+
+    all_pairs = []
+
+    # Scan CC
+    cc_path = Path(args.cc_dir)
+    if cc_path.exists():
+        for proj_dir in cc_path.iterdir():
+            if not proj_dir.is_dir():
+                continue
+            if args.project and args.project not in proj_dir.name:
+                continue
+            for jf in proj_dir.glob("*.jsonl"):
+                if cutoff and os.path.getmtime(jf) < cutoff:
+                    continue
+                try:
+                    all_pairs.extend(scan_session(jf, "cc", proj_dir.name))
+                except Exception:
+                    pass
+
+    # Scan Pi
+    pi_path = Path(args.pi_dir)
+    if pi_path.exists():
+        for proj_dir in pi_path.iterdir():
+            if not proj_dir.is_dir():
+                continue
+            if args.project and args.project not in proj_dir.name:
+                continue
+            for jf in proj_dir.glob("*.jsonl"):
+                if cutoff and os.path.getmtime(jf) < cutoff:
+                    continue
+                try:
+                    all_pairs.extend(scan_session(jf, "pi", proj_dir.name))
+                except Exception:
+                    pass
+
+    all_pairs.sort(key=lambda p: p["date"], reverse=True)
+
+    text = json.dumps(all_pairs, indent=2, ensure_ascii=False)
+    if args.output:
+        Path(args.output).write_text(text)
+        print(f"Extracted {len(all_pairs)} pairs -> {args.output}", file=sys.stderr)
+    else:
+        print(text)
+
+
+if __name__ == "__main__":
+    main()
