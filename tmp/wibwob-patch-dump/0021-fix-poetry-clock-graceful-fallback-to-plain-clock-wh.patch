From 821a3803b3e9ec353cf875a3343e08d522b77690 Mon Sep 17 00:00:00 2001
From: James Greig <3stripe@gmail.com>
Date: Sat, 7 Mar 2026 12:31:35 +0000
Subject: [PATCH 21/32] fix(poetry-clock): graceful fallback to plain clock
 when no API key

---
 .pi/todos/011ca571.md                |  2 +-
 modules/wibwob-poetry-clock/index.ts | 21 ++++++++++++++++++++-
 2 files changed, 21 insertions(+), 2 deletions(-)

diff --git a/.pi/todos/011ca571.md b/.pi/todos/011ca571.md
index f1eb251..79f985d 100644
--- a/.pi/todos/011ca571.md
+++ b/.pi/todos/011ca571.md
@@ -7,7 +7,7 @@
     "poetry-clock",
     "inference"
   ],
-  "status": "open",
+  "status": "closed",
   "created_at": "2026-03-07T10:25:16.175Z"
 }
 
diff --git a/modules/wibwob-poetry-clock/index.ts b/modules/wibwob-poetry-clock/index.ts
index 453e034..b8e6140 100644
--- a/modules/wibwob-poetry-clock/index.ts
+++ b/modules/wibwob-poetry-clock/index.ts
@@ -391,6 +391,9 @@ export default function setup(host: MicroappHost) {
     let lastDate = "";
     let generating = false;
     let lastGeneratedMinute = -1;
+    // Set when inference is attempted but no auth token is present.
+    // Shown in the status bar so the user knows why sentient mode is unavailable.
+    let noInferenceNote = "";
 
     clockControl = {
       setMode(targetMode: ClockMode, targetVoice?: Voice) {
@@ -497,6 +500,18 @@ export default function setup(host: MicroappHost) {
         return;
       }
 
+      // Guard: check for auth token before entering the generating state.
+      // If unavailable, stay in clock mode and show a permanent status note.
+      if (!readOAuthToken()) {
+        noInferenceNote = "Inference unavailable — no API key. Plain clock mode.";
+        mode = "clock";
+        voice = "plain";
+        render();
+        return;
+      }
+
+      noInferenceNote = "";
+
       if (voice === "terrain") {
         terrainPlayer.shuffle();
       }
@@ -541,7 +556,11 @@ export default function setup(host: MicroappHost) {
 
       if (mode === "clock") {
         poemBlock.update({ text: "" });
-        statusBar.update({ left: "", right: "[m]ode" });
+        if (noInferenceNote) {
+          statusBar.update({ left: noInferenceNote, right: "" });
+        } else {
+          statusBar.update({ left: "", right: "[m]ode" });
+        }
       } else if (generating) {
         poemBlock.update({ text: "..." });
         statusBar.update({ left: VOICE_LABELS[voice], right: "[m]ode" });
-- 
