From e3df956e811cafd9e3f45f5846681bce1b582de0 Mon Sep 17 00:00:00 2001
From: James Greig <3stripe@gmail.com>
Date: Sat, 7 Mar 2026 12:24:24 +0000
Subject: [PATCH 16/32] fix(e022-s05): hybrid iso pane uses pane-sized world,
 not compressed contour world
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Previously the hybrid right pane fed the large contour-optimised terrain
(worldDimensions) into renderIso, causing stride compression and a small diamond.

Now the right pane generates its own iso-optimised terrain using the same
N×N formula as standalone ISO mode, sized to hybridIsoViewportW/H. Same
seed/seaLevel/terrainIdx — visual consistency with the left contour pane.

Separate cache (hybridIsoArtifact/hybridIsoCacheKey) invalidates on resize.
Standalone ISO cache (hybridArtifact/hybridCacheKey) unchanged.
---
 modules/wibwobworld/index.ts | 29 +++++++++++++++++++++--------
 1 file changed, 21 insertions(+), 8 deletions(-)

diff --git a/modules/wibwobworld/index.ts b/modules/wibwobworld/index.ts
index adebaaf..a0e140c 100644
--- a/modules/wibwobworld/index.ts
+++ b/modules/wibwobworld/index.ts
@@ -202,6 +202,9 @@ export default function setup(host: MicroappHost) {
     let latestJoinedChannelId = "";
     let hybridCacheKey = "";
     let hybridArtifact: SavedTerrainArtifact | undefined;
+    // Separate cache for the hybrid iso pane — sized to the half-window, not the contour world.
+    let hybridIsoCacheKey = "";
+    let hybridIsoArtifact: SavedTerrainArtifact | undefined;
     // First-person camera state (independent of focus/terrain generation)
     let fpYaw: number | undefined; // undefined = auto-toward-peak
     let fpCamX: number | undefined; // undefined = use focus
@@ -523,20 +526,30 @@ export default function setup(host: MicroappHost) {
             mapBox.setContent("");
           }
           if (isoPaneW >= 1 && isoPaneH >= 1) {
-            const cacheKey = `${seed}|${seaLevel.toFixed(4)}|${levels}|${terrainIdx}`;
-            if (cacheKey !== hybridCacheKey || !hybridArtifact) {
-              hybridArtifact = createSavedTerrainArtifact({
-                map: terrain,
-                focus,
-                renderMode,
+            // Size the iso world to the pane (same formula as standalone ISO mode),
+            // not the large contour world — avoids stride compression in the right pane.
+            const isoN = Math.max(12, Math.min(
+              Math.floor(hybridIsoViewportW / 4),
+              Math.floor((hybridIsoViewportH - 10) / 2),
+            ));
+            const isoCacheKey = `${seed}|${seaLevel.toFixed(4)}|${levels}|${terrainIdx}|${isoN}`;
+            if (isoCacheKey !== hybridIsoCacheKey || !hybridIsoArtifact) {
+              const isoTerrain = createTerrainMap({
+                width: isoN, height: isoN, seed, terrainIdx, seaLevel, vegetationEnabled,
+              });
+              const isoFocus = getTerrainFocusPoint(isoTerrain);
+              hybridIsoArtifact = createSavedTerrainArtifact({
+                map: isoTerrain,
+                focus: isoFocus,
+                renderMode: "iso",
                 levels,
                 playerLabel: PLAYER_LABEL,
                 playerGlyph: PLAYER_GLYPH,
                 playerSprite: PLAYER_SPRITE,
               });
-              hybridCacheKey = cacheKey;
+              hybridIsoCacheKey = isoCacheKey;
             }
-            isoRows = renderIso(hybridArtifact, hybridIsoViewportW, hybridIsoViewportH);
+            isoRows = renderIso(hybridIsoArtifact, hybridIsoViewportW, hybridIsoViewportH);
             isoBox.setContent(isoRows.join("\n"));
           } else {
             isoBox.setContent("");
