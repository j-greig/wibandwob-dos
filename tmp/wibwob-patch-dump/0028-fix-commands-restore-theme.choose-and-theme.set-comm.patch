+  private chooseTheme(): void {
+    const variants = allVariants();
+    const current = themeName();
+    this.overlays.openListPrompt(
+      "Choose Theme",
+      variants.map((v) => ({ label: v.name === current ? `● ${v.name}` : `  ${v.name}`, variantName: v.name })),
+      variants.findIndex((v) => v.name === current),
+      (item: { label: string; variantName: string }) => {
+        const v = allVariants().find((x) => x.name === item.variantName);
+        if (v) { setThemeVariant(v); this.applyTheme(); }
+      },
+    );
+  }
+
+  private setThemeByName(args?: Record<string, unknown>): void {
+    const name = String(args?.name ?? "");
+    const variant = allVariants().find((v) => v.name === name);
+    if (!variant) {
+      this.overlays.flash(`Unknown theme: ${name}. Available: ${allVariants().map((v) => v.name).join(", ")}`);
+      return;
+    }
+    setThemeVariant(variant);
+    this.applyTheme();
+  }
+
+  private applyTheme(): void {
+    this.menuBar.style = theme().menuBar;
+    this.desktop.style = theme().desktop;
+    this.statusLine.style = theme().statusLine;
+    this.menuUi?.restyle?.();
+    this.windowManager.restyleAll();
+  }
+
   private toggleTheme(): void {
     toggleThemeVariant();
