// Shape morphing animation
element morphShape {
  x: 400
  y: 300
  width: 100
  height: 100
  shape: circle
  color: #00ffff
}

flow circleToSquare on morphShape {
  @0s -> {
    radius: 50
    rotation: 0
  }
  @2s -> {
    radius: 0
    rotation: 180
  }
  ease: smooth
}

flow changeColor on morphShape {
  @0s -> color: #00ffff
  @1s -> color: #ff00ff
  @2s -> color: #ffff00
  @3s -> color: #00ffff
  ease: smooth
}

sequence morphSequence {
  parallel {
    play circleToSquare
    play changeColor
  }
  wait @0.5s
  parallel {
    play circleToSquare
    play changeColor
  }
}

on load {
  start morphSequence
}

on click {
  toggle morphSequence
}
