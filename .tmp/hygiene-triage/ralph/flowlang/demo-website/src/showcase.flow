// FlowLang Showcase - Animated Demo Website
// Demonstrates particles, morphing, and complex animations

// Title
element title {
  x: 400
  y: 100
  shape: text
  content: "FlowLang"
  fontSize: 72
  color: #00ffff
  opacity: 0
}

// Subtitle
element subtitle {
  x: 380
  y: 180
  shape: text
  content: "Motion-Native Programming"
  fontSize: 24
  color: #ffffff
  opacity: 0
}

// Morphing shape centerpiece
element morphShape {
  x: 375
  y: 300
  width: 50
  height: 50
  shape: circle
  color: #ff00ff
  opacity: 0
}

// Bouncing balls
element ball1 {
  x: 200
  y: 50
  width: 30
  height: 30
  shape: circle
  color: #ff0000
}

element ball2 {
  x: 600
  y: 50
  width: 30
  height: 30
  shape: circle
  color: #00ff00
}

// Particle system for stars
particles stars {
  count: 50
  spawn: {
    x: random(0, 800)
    y: random(0, 600)
    width: 2
    height: 2
    shape: circle
    color: #ffffff
    opacity: random(0.3, 1)
  }
}

// Title fade in
flow titleFadeIn on title {
  @0s -> opacity: 0
  @1s -> opacity: 1
  ease: smooth
}

// Subtitle fade in (delayed)
flow subtitleFadeIn on subtitle {
  @0s -> opacity: 0
  @1.5s -> opacity: 1
  ease: smooth
}

// Morphing shape animation
flow morphAppear on morphShape {
  @0s -> {
    opacity: 0
    width: 50
    height: 50
  }
  @1s -> {
    opacity: 1
    width: 50
    height: 50
  }
  ease: smooth
}

flow morphPulse on morphShape {
  @0s -> {
    width: 50
    height: 50
  }
  @1s -> {
    width: 80
    height: 80
  }
  @2s -> {
    width: 50
    height: 50
  }
  ease: smooth
  repeat: infinite
}

flow morphColorCycle on morphShape {
  @0s -> color: #ff00ff
  @1s -> color: #00ffff
  @2s -> color: #ffff00
  @3s -> color: #ff00ff
  ease: smooth
  repeat: infinite
}

// Bouncing animations
flow bounce1 on ball1 {
  @0s -> y: 50
  @0.5s -> y: 500
  @1s -> y: 50
  ease: bounce
  repeat: infinite
}

flow bounce2 on ball2 {
  @0s -> y: 50
  @0.6s -> y: 500
  @1.2s -> y: 50
  ease: bounce
  repeat: infinite
}

// Start all animations on load
on load {
  start titleFadeIn
  start subtitleFadeIn
  start morphAppear
  start morphPulse
  start morphColorCycle
  start bounce1
  start bounce2
  spawn stars
}
