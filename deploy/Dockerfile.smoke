# WibWob-DOS VPS smoke image
# Ubuntu 24.04 + Bun — mirrors wibwob1 Hetzner (aarch64, Ubuntu 24.04)
# Build: docker build --platform linux/arm64 -t wibwob-vps-smoke -f deploy/Dockerfile.smoke .
# Run:  docker run -d -t -p 127.0.0.1:2849:22 --platform linux/arm64 --name wibwob-smoke wibwob-vps-smoke

# SEC-H4: pinned digest — update deliberately, not silently on rebuild
# To update: docker pull --platform linux/arm64 ubuntu:24.04 && docker inspect ubuntu:24.04 | grep RepoDigests
FROM ubuntu:24.04@sha256:d1e2e92c075e5ca139d51a140fff46f84315c0fdce203eab2807c7e495eff4f9

ENV DEBIAN_FRONTEND=noninteractive

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl unzip git tmux openssh-server ca-certificates figlet python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Figlet fonts — install pyfiglet (148 fonts), copy to system figlet dir, remove pip artefacts
RUN pip3 install --break-system-packages pyfiglet \
    && python3 -c "\
import pyfiglet, shutil; from pathlib import Path; \
shutil.copytree(Path(pyfiglet.__file__).parent/'fonts', Path('/usr/share/figlet'), dirs_exist_ok=True)" \
    && pip3 uninstall -y --break-system-packages pyfiglet \
    && rm -rf /root/.cache/pip

# Install Bun — use install script (robust, handles arch detection)
# Copy to /usr/local/bin so non-root wibwob user can find it on PATH
ENV BUN_VERSION=1.2.4
# SEC-H4: pinned Bun version — curl|bash with pinned version tag
# To update: check https://github.com/oven-sh/bun/releases
RUN curl -fsSL https://bun.sh/install | bash -s -- bun-v1.3.10 \
    && mkdir -p /usr/local/bin \
    && cp /root/.bun/bin/bun /usr/local/bin/bun \
    && rm -rf /root/.bun \
    && bun --version

# ttyd — web terminal (xterm.js frontend, WebSocket PTY backend)
# SEC-H4: pinned ttyd version — never pull "latest" silently
# To update: check https://github.com/tsl0922/ttyd/releases
RUN curl -fsSL "https://github.com/tsl0922/ttyd/releases/download/1.7.7/ttyd.aarch64" \
      -o /usr/local/bin/ttyd \
    && chmod +x /usr/local/bin/ttyd \
    && ttyd --version

# Generate sshd host keys
RUN ssh-keygen -A

# SSH hardening — use sshd_config.d (Ubuntu 24.04 canonical approach, avoids fragile sed)
RUN echo "PasswordAuthentication no" > /etc/ssh/sshd_config.d/99-smoke.conf \
    && echo "AuthenticationMethods publickey" >> /etc/ssh/sshd_config.d/99-smoke.conf \
    && echo "X11Forwarding no" >> /etc/ssh/sshd_config.d/99-smoke.conf \
    && echo "AllowAgentForwarding no" >> /etc/ssh/sshd_config.d/99-smoke.conf

# Create wibwob user (non-root — mirrors VPS requirement)
RUN useradd -m -s /bin/bash wibwob \
    && mkdir -p /home/wibwob/.ssh \
    && chmod 700 /home/wibwob/.ssh

# Generate ephemeral SSH keypair at build time — private key stays in image only.
# smoke-restart.sh extracts it via `docker cp` after container starts.
# The private key is NEVER committed to the repo.
RUN ssh-keygen -t ed25519 -C "wibwob-smoke-ephemeral" -N "" \
      -f /home/wibwob/.ssh/smoke_key \
    && cp /home/wibwob/.ssh/smoke_key.pub /home/wibwob/.ssh/authorized_keys \
    && chmod 600 /home/wibwob/.ssh/authorized_keys /home/wibwob/.ssh/smoke_key \
    && chown -R wibwob:wibwob /home/wibwob/.ssh

# App — copy source, install deps as wibwob
# Layer: package files first for bun install cache
COPY --chown=wibwob:wibwob package.json bun.lock /opt/wibandwob-dos/
# --ignore-scripts: skips canvas native build (not imported in source) and
# puppeteer chromium download (not needed for smoke). bun-pty pre-built .so
# in its dist/ works without recompile.
RUN cd /opt/wibandwob-dos && su -c "bun install --ignore-scripts" wibwob

# Layer: full source
COPY --chown=wibwob:wibwob src /opt/wibandwob-dos/src
COPY --chown=wibwob:wibwob tsconfig.json /opt/wibandwob-dos/
COPY --chown=wibwob:wibwob modules /opt/wibandwob-dos/modules
COPY --chown=wibwob:wibwob modules-private /opt/wibandwob-dos/modules-private
COPY --chown=wibwob:wibwob README.md /opt/wibandwob-dos/
COPY --chown=wibwob:wibwob AGENTS.md /opt/wibandwob-dos/
COPY --chown=wibwob:wibwob WELCOME.md /opt/wibandwob-dos/
COPY --chown=wibwob:wibwob config /opt/wibandwob-dos/config

# Minimal smoke .env — local transport (no IRC), named instance
# Optional override (leave unset for per-instance runtime generation):
# WIBWOB_CONTROL_TOKEN=
RUN printf 'WIBWOB_INSTANCE_LABEL=smoke\nWIBWOB_DEPLOY_PROFILE=docker-safe\n' \
      > /opt/wibandwob-dos/.env \
    && chown wibwob:wibwob /opt/wibandwob-dos/.env \
    && chmod 600 /opt/wibandwob-dos/.env

# Entrypoint
COPY deploy/smoke-entrypoint.sh /usr/local/bin/smoke-entrypoint.sh
RUN chmod +x /usr/local/bin/smoke-entrypoint.sh

# /run/sshd needed by sshd privilege separation
RUN mkdir -p /run/sshd

EXPOSE 22 7681

ENTRYPOINT ["/usr/local/bin/smoke-entrypoint.sh"]
