dos.wibandwob.com {
    # tls internal is correct here — Cloudflare (orange cloud) terminates
    # public TLS at the edge. This cert covers the CF -> origin leg only.
    # CF SSL mode should be set to "Full" (not Flexible, not Full Strict).
    tls internal

    # --- Agent: control API lane ---
    # Bearer token auth enforced inside the app (control-api.ts).
    handle_path /api/* {
        reverse_proxy wibwob:8099
    }

    # --- Human: browser TUI lane ---
    handle {
        basic_auth {
            wibwob {env.WIBWOB_BASIC_AUTH_HASH}
        }
        reverse_proxy wibwob:7681
    }

    log {
        output file /data/logs/access.log
        format json
    }
}
