#!/usr/bin/env bash
# pre-commit — blocks commits if doc loop is broken
# Install: bash scripts/install-hooks.sh

cd "$(git rev-parse --show-toplevel)"

echo "doc-sync: checking for stale outputs..."
if ! bash scripts/doc-sync.sh --check > /dev/null 2>&1; then
  echo "✗ stale generated outputs — run: bash scripts/doc-sync.sh"
  exit 1
fi

echo "doc-health: checking loop integrity..."
RESULT=$(bash scripts/doc-health.sh --json 2>/dev/null)
SCORE=$(echo "$RESULT" | python3 -c "import json,sys; print(json.load(sys.stdin)['score'])" 2>/dev/null || echo "0")
MAX=$(echo "$RESULT" | python3 -c "import json,sys; print(json.load(sys.stdin)['max'])" 2>/dev/null || echo "80")

if [[ "$SCORE" -lt "$MAX" ]]; then
  echo "✗ doc-health: $SCORE/$MAX — fix open loops before committing"
  echo "$RESULT" | python3 -c "
import json,sys
d = json.load(sys.stdin)
for i in d.get('issues', []):
    print(f'  · {i}')
" 2>/dev/null
  exit 1
fi

echo "✓ doc-health: $SCORE/$MAX — loop closed"
exit 0
