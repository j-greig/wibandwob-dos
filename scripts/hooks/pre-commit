#!/usr/bin/env bash
# pre-commit — blocks commits if doc loop is broken
# Install: bash scripts/install-hooks.sh

cd "$(git rev-parse --show-toplevel)"

echo "doc-sync: checking for stale outputs..."
if ! bash scripts/doc-sync.sh --check > /dev/null 2>&1; then
  echo "✗ stale generated outputs — run: bash scripts/doc-sync.sh"
  exit 1
fi

echo "doc-health: checking loop integrity..."
SCORE=$(bash scripts/doc-health.sh 2>/dev/null | grep -oE 'doc_health=[0-9]+' | grep -oE '[0-9]+')
TOTAL=$(grep -c '^check ' scripts/doc-health.sh 2>/dev/null || echo 13)

if [[ -z "$SCORE" || "$SCORE" -lt "$TOTAL" ]]; then
  echo "✗ doc-health: ${SCORE:-0}/$TOTAL — fix open loops before committing"
  VERBOSE=1 bash scripts/doc-health.sh 2>&1 | grep "✗" || true
  exit 1
fi

echo "✓ doc-health: $SCORE/$TOTAL — loop closed"

# Check scaffold template matches guide patterns (lightweight, no instance needed)
if ! bash scripts/checks/check-scaffold-sync.sh > /dev/null 2>&1; then
  echo "✗ scaffold template drifted from guide — run: bash scripts/checks/check-scaffold-sync.sh"
  exit 1
fi

exit 0
