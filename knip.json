{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app.ts",
    "src/cli/*.ts",
    "microapps/*/index.ts"
  ],
  "project": ["src/**/*.ts"],
  "ignore": [
    ".pi/**",
    ".agents/**",
    ".planning/**",
    "scripts/**",
    ".trash/**",
    "microapps/.disabled/**",
    "autoresearch/**",
    "deploy/**",
    "scratch/**",
    "src/tests/**"
  ],
  "ignoreDependencies": ["blessed"]
}
