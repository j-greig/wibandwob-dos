#!/usr/bin/env bash
set -euo pipefail

BRANCH="$(git branch --show-current)"
[[ "$BRANCH" == "main" ]] && echo "✗ No direct commits to main." >&2 && exit 1

node_modules/.bin/tsc --noEmit              || { echo "✗ Typecheck failed." >&2; exit 1; }
npx eslint 'microapps/**/*.ts' --ignore-pattern 'microapps/.disabled/**' || { echo "✗ SDK boundary violated." >&2; exit 1; }
bash scripts/doc-sync.sh --check            || { echo "✗ Stale gen outputs — run: bash scripts/doc-sync.sh" >&2; exit 1; }
